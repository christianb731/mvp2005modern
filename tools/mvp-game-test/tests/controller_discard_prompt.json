{
  "name": "controller_discard_prompt",
  "description": "Use the controller to open the Audio Options discard prompt, select each answer, and verify the resulting screens.",
  "force_cleanup": true,
  "capture_on_failure": true,
  "steps": [
    {"action": "launch"},
    {"action": "wait_window", "timeout": 15},
    {"action": "wait_log", "contains": "class_rva=004b7900", "timeout": 20},
    {"action": "wait_log", "source": "intro", "contains": "AUTO SKIP PASS", "timeout": 6},
    {"action": "wait_pixels", "timeout": 12, "tolerance": 24, "samples": [[0.47, 0.462, 236, 237, 240], [0.53, 0.462, 243, 244, 245], [0.47, 0.472, 70, 70, 72], [0.53, 0.472, 70, 71, 72]]},
    {"action": "menu_input", "scene": "title", "button": "a", "timeout": 3},
    {"action": "wait_log", "contains": "menu test grid row=0 controller_focus=0", "timeout": 8},
    {"action": "wait", "seconds": 1.4},
    {"action": "click", "relative": true, "x": 0.27, "y": 0.425},
    {"action": "wait_log", "contains": "class_rva=004b8020", "timeout": 4},
    {"action": "wait", "seconds": 1.7},
    {"action": "click", "relative": true, "x": 0.69, "y": 0.473},
    {"action": "wait_log", "contains": "class_rva=004b71c0", "timeout": 4},
    {"action": "wait", "seconds": 1.7},
    {"action": "click", "relative": true, "x": 0.27, "y": 0.362},
    {"action": "wait_log", "contains": "class_rva=004bebf0", "timeout": 4},
    {"action": "wait", "seconds": 1.7},
    {"action": "screenshot", "name": "audio-before-edit"},
    {"action": "click", "relative": true, "x": 0.528, "y": 0.275},
    {"action": "wait", "seconds": 0.6},
    {"action": "move_cursor", "relative": true, "x": 0.12, "y": 0.7},
    {"action": "menu_input", "scene": "audio", "button": "b", "timeout": 3},
    {"action": "wait_log", "contains": "class_rva=004a5ed8", "timeout": 4},
    {"action": "wait", "seconds": 0.8},
    {"action": "menu_input", "scene": "prompt", "button": "down", "timeout": 3},
    {"action": "wait_log", "contains": "menu test prompt grid row=1 controller_focus=1", "timeout": 4},
    {"action": "menu_input", "scene": "prompt", "button": "up", "timeout": 3},
    {"action": "wait_log", "contains": "menu test prompt grid row=0 controller_focus=1", "timeout": 4},
    {"action": "wait", "seconds": 0.4},
    {"action": "screenshot", "name": "discard-no"},
    {"action": "menu_input", "scene": "prompt", "button": "a", "timeout": 3},
    {"action": "wait_log", "contains": "class_rva=004bebf0", "timeout": 4},
    {"action": "wait", "seconds": 1.1},
    {"action": "screenshot", "name": "audio-edit-kept"},
    {"action": "menu_input", "scene": "audio", "button": "b", "timeout": 3},
    {"action": "wait_log", "contains": "class_rva=004a5ed8", "timeout": 4},
    {"action": "wait", "seconds": 0.8},
    {"action": "menu_input", "scene": "prompt", "button": "down", "timeout": 3},
    {"action": "wait_log", "contains": "menu test prompt grid row=1 controller_focus=1", "timeout": 4},
    {"action": "wait", "seconds": 0.4},
    {"action": "screenshot", "name": "discard-yes"},
    {"action": "menu_input", "scene": "prompt", "button": "a", "timeout": 3},
    {"action": "wait_log", "contains": "class_rva=004b71c0", "timeout": 4},
    {"action": "wait", "seconds": 1.7},
    {"action": "click", "relative": true, "x": 0.27, "y": 0.362},
    {"action": "wait_log", "contains": "class_rva=004bebf0", "timeout": 4},
    {"action": "wait", "seconds": 1.7},
    {"action": "screenshot", "name": "audio-edit-discarded"}
  ]
}
