{
  "name": "controller_title_navigation",
  "description": "Use only simulated controller input to leave the title screen, open Play Now and return from Team Select.",
  "force_cleanup": true,
  "capture_on_failure": true,
  "steps": [
    {"action": "launch"},
    {"action": "wait_window", "timeout": 20},
    {"action": "wait_log", "contains": "menu controller title enabled", "timeout": 10},
    {"action": "wait_log", "contains": "class_rva=004b7900", "timeout": 25},
    {"action": "wait_log", "source": "intro", "contains": "AUTO SKIP PASS", "timeout": 10},
    {"action": "wait_pixels", "timeout": 18, "tolerance": 24, "samples": [[0.47, 0.462, 236, 237, 240], [0.53, 0.462, 243, 244, 245], [0.47, 0.472, 70, 70, 72], [0.53, 0.472, 70, 71, 72]]},
    {"action": "screenshot", "name": "title"},
    {"action": "menu_input", "scene": "title", "button": "a"},
    {"action": "wait_log", "contains": "menu test grid row=0 controller_focus=0", "timeout": 10},
    {"action": "menu_input", "scene": "main", "button": "a"},
    {"action": "wait_log", "contains": "class_rva=004bcdb8", "timeout": 10},
    {"action": "menu_input", "scene": "team", "button": "b"},
    {"action": "wait_log", "contains": "menu test team back handled", "timeout": 5},
    {"action": "wait_log", "contains": "class_rva=004b74b0", "timeout": 10}
  ]
}
