{
  "name": "controller_video_options_navigation",
  "description": "Adjust Video Options, use the stock Auto-Detect action, discard a setting change, and verify Accept.",
  "force_cleanup": true,
  "capture_on_failure": true,
  "steps": [
    {"action": "launch"},
    {"action": "wait_log", "contains": "class_rva=004b7900", "timeout": 20},
    {"action": "wait_log", "source": "intro", "contains": "AUTO SKIP PASS", "timeout": 10},
    {"action": "wait_pixels", "timeout": 12, "tolerance": 24, "samples": [[0.47, 0.462, 236, 237, 240], [0.53, 0.462, 243, 244, 245], [0.47, 0.472, 70, 70, 72], [0.53, 0.472, 70, 71, 72]]},
    {"action": "menu_input", "scene": "title", "button": "a", "timeout": 3},
    {"action": "wait_log", "contains": "menu test grid row=0 controller_focus=0", "timeout": 8},
    {"action": "wait", "seconds": 2.3},
    {"action": "click", "relative": true, "x": 0.27, "y": 0.425},
    {"action": "wait_log", "contains": "class_rva=004b8020", "timeout": 4},
    {"action": "wait", "seconds": 1.7},
    {"action": "click", "relative": true, "x": 0.69, "y": 0.473},
    {"action": "wait_log", "contains": "class_rva=004b71c0", "timeout": 4},
    {"action": "wait", "seconds": 1.7},
    {"action": "move_cursor", "relative": true, "x": 0.95, "y": 0.13},
    {"action": "menu_input", "scene": "options", "button": "down", "timeout": 3},
    {"action": "menu_input", "scene": "options", "button": "down", "timeout": 3},
    {"action": "menu_input", "scene": "options", "button": "down", "timeout": 3},
    {"action": "wait_log", "contains": "menu test options grid row=3 controller_focus=1", "timeout": 4},
    {"action": "menu_input", "scene": "options", "button": "a", "timeout": 3},
    {"action": "wait_log", "contains": "class_rva=004b7330", "timeout": 4},
    {"action": "wait", "seconds": 1.8},
    {"action": "menu_input", "scene": "video", "button": "down", "timeout": 3},
    {"action": "wait_log", "contains": "menu test video grid row=1 controller_focus=1", "timeout": 4},
    {"action": "menu_input", "scene": "video", "button": "up", "timeout": 3},
    {"action": "wait_log", "contains": "menu test video grid row=0 controller_focus=1", "timeout": 4},
    {"action": "screenshot", "name": "video-original"},
    {"action": "menu_input", "scene": "video", "button": "left", "timeout": 3},
    {"action": "wait_log", "contains": "menu test video value action=10 handled", "timeout": 4},
    {"action": "wait", "seconds": 0.45},
    {"action": "screenshot", "name": "video-edited"},
    {"action": "menu_input", "scene": "video", "button": "y", "timeout": 3},
    {"action": "wait_log", "contains": "menu test dispatch scene=004b7330 action=3", "timeout": 4},
    {"action": "wait", "seconds": 0.65},
    {"action": "screenshot", "name": "video-auto-detect"},
    {"action": "menu_input", "scene": "video", "button": "right", "timeout": 3},
    {"action": "wait_log", "contains": "menu test video value action=12 handled", "timeout": 4},
    {"action": "menu_input", "scene": "video", "button": "b", "timeout": 3},
    {"action": "wait_log", "contains": "class_rva=004a5ed8", "timeout": 4},
    {"action": "wait", "seconds": 0.8},
    {"action": "menu_input", "scene": "prompt", "button": "down", "timeout": 3},
    {"action": "wait_log", "contains": "menu test prompt grid row=1 controller_focus=1", "timeout": 4},
    {"action": "menu_input", "scene": "prompt", "button": "a", "timeout": 3},
    {"action": "wait_log", "contains": "class_rva=004b71c0", "timeout": 4},
    {"action": "wait", "seconds": 1.7},
    {"action": "click", "relative": true, "x": 0.27, "y": 0.518},
    {"action": "wait_log", "contains": "class_rva=004b7330", "timeout": 4},
    {"action": "wait", "seconds": 1.8},
    {"action": "screenshot", "name": "video-restored"},
    {"action": "menu_input", "scene": "video", "button": "a", "timeout": 3},
    {"action": "wait_log", "contains": "class_rva=004b71c0", "timeout": 4}
  ]
}
